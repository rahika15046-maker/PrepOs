# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database
# ⚠️ The MongoDB URI, Gemini key and Google Vision key that used to be hardcoded
# here were real, live credentials committed in plaintext. They have been
# removed. If you ever used this file as-is, rotate/delete those credentials
# immediately (MongoDB Atlas password, Gemini API key, Google Vision API key) —
# treat them as compromised. Never commit real secrets to a repo, even a
# private one; use environment variables / a secrets manager in production.
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/prepos?retryWrites=true&w=majority

# Auth
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=7d
COOKIE_SECRET=replace-with-a-long-random-string

# AI provider — REQUIRED. PrepOS deliberately has no "mock" AI mode: every
# roadmap, quiz, and interview evaluation is a real assessment, never
# fabricated placeholder content (a fake quiz score would defeat the whole
# point of "verified" progress). You must supply a real key below.
# "gemini" has a generous free tier — get a key in under a minute at
# https://aistudio.google.com/apikey — or use "openai" instead.
AI_PROVIDER=gemini
AI_MODEL=gemini-2.5-flash
AI_TIMEOUT_MS=45000
AI_MAX_INPUT_CHARS=120000
AI_MAX_OUTPUT_TOKENS=8000

GEMINI_API_KEY=your-gemini-api-key-here
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1

# OCR provider — "mock" | "tesseract" | "google-vision" | "ai-vision"
OCR_PROVIDER=mock
GOOGLE_VISION_API_KEY=your-google-vision-api-key-here

# File uploads
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=15

# LinkedIn OAuth (Sign In with LinkedIn using OpenID Connect) — connect-only,
# never posts on the user's behalf. Register an app at
# https://www.linkedin.com/developers/apps to get these.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:5000/api/linkedin/oauth/callback

# Job search — "mock" | "adzuna". Adzuna has a free tier:
# https://developer.adzuna.com
JOB_SEARCH_PROVIDER=adzuna

ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=in

JOB_MAX_AGE_HOURS=168
JOB_SEARCH_TIMEOUT_MS=15000

# Rate limiting
GENERAL_RATE_LIMIT=300
AUTH_RATE_LIMIT=20
AI_RATE_LIMIT=30
